{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*": ["src/hooks/*"],
      "@contexts/*": ["src/contexts/*"],
      "@services/*": ["src/services/*"],
      "@schemas/*": ["src/schemas/*"],
      "@data/*": ["src/data/*"],
      "@styles/*": ["src/styles/*"],
      "@sections/*": ["src/sections/*"]
    }
  },
  "include": ["src/**/*"]
}